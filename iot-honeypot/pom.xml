<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.security</groupId>
    <artifactId>iot-honeypot</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>IoT Deception Honeypot</name>
    <description>A low-interaction SSH honeypot that mimics a vulnerable IoT device.</description>

    <properties>
        <!-- `release` compiles against the Java 17 platform APIs as well as
             producing Java 17 bytecode.  `source`/`target` alone permits
             accidental use of newer JDK APIs when building on JDK 23. -->
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Pinned versions for reproducibility -->
        <sshd.version>2.12.0</sshd.version>
        <sqlite.version>3.45.1.0</sqlite.version>
        <slf4j.version>2.0.12</slf4j.version>
        <logback.version>1.4.14</logback.version>
        <shade.plugin.version>3.5.1</shade.plugin.version>
    </properties>

    <dependencies>
        <!-- Apache MINA SSHD: SSH server core -->
        <dependency>
            <groupId>org.apache.sshd</groupId>
            <artifactId>sshd-core</artifactId>
            <version>${sshd.version}</version>
        </dependency>

        <!-- BouncyCastle: required for Ed25519 host key sign/verify in MINA SSHD.
             JDK 23 has native Ed25519 for the JCE but MINA SSHD 2.12.0 still
             hardcodes `Signature.getInstance("Ed25519", "BC")` for the signer
             factory, so without BC the Ed25519 path fails with
             "EdDSA Signer not available". -->
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcprov-jdk18on</artifactId>
            <version>1.78.1</version>
        </dependency>

        <!-- SQLite JDBC for embedded persistence -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>${sqlite.version}</version>
        </dependency>

        <!-- SLF4J + Logback for logging -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j.version}</version>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <version>${logback.version}</version>
        </dependency>
    </dependencies>

    <build>
        <finalName>iot-honeypot</finalName>
        <plugins>
            <!-- Compiler plugin -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
            </plugin>

            <!-- Copy BouncyCastle (and other non-shaded deps) to lib/ so they
                 survive as signed JARs at runtime. JDK 23 JCE authentication
                 rejects repackaged provider JARs. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.6.1</version>
                <executions>
                    <execution>
                        <id>copy-bc-to-lib</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <includeGroupIds>org.bouncycastle</includeGroupIds>
                            <includeScope>compile</includeScope>
                            <outputDirectory>${project.basedir}/lib</outputDirectory>
                            <stripVersion>false</stripVersion>
                        </configuration>
                    </execution>
                    <execution>
                        <id>copy-bc-to-target-lib</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <includeGroupIds>org.bouncycastle</includeGroupIds>
                            <includeScope>compile</includeScope>
                            <outputDirectory>${project.build.directory}/lib</outputDirectory>
                            <stripVersion>false</stripVersion>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Shade plugin: produce a single runnable fat JAR -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>${shade.plugin.version}</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <shadedArtifactAttached>false</shadedArtifactAttached>
                            <transformers>
                                <!-- Add a Manifest-Class-Path so java -jar can find
                                     BouncyCastleProvider in ./lib even when BC is not
                                     shaded into the fat JAR. -->
                                <transformer
                                    implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>com.security.honeypot.HoneypotCli</mainClass>
                                    <manifestEntries>
                                        <Class-Path>lib/bcprov-jdk18on-1.78.1.jar ../lib/bcprov-jdk18on-1.78.1.jar</Class-Path>
                                    </manifestEntries>
                                </transformer>

                                <!-- CRITICAL: merge META-INF/services files for MINA SSHD SPI discovery -->
                                <transformer
                                    implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>META-INF/*.EC</exclude>
                                        <exclude>module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <!-- Do NOT shade BouncyCastle into the fat JAR. JDK 23 JCE
                                 authenticates provider JARs by their signed manifest;
                                 once a signed JAR is repackaged inside a fat JAR the
                                 `JCE cannot authenticate the provider BC` exception
                                 fires. Keep BC as an external classpath entry so its
                                 signed manifest bytes remain intact. -->
                            <artifactSet>
                                <excludes>
                                    <exclude>org.bouncycastle:bcprov-jdk18on</exclude>
                                    <exclude>org.bouncycastle:bcutil-jdk18on</exclude>
                                    <exclude>org.bouncycastle:bcpkix-jdk18on</exclude>
                                    <exclude>org.bouncycastle:bcpg-jdk18on</exclude>
                                </excludes>
                            </artifactSet>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
