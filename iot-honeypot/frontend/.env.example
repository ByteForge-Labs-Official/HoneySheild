# API endpoint (proxied through Vite in dev)
VITE_API_BASE_URL=/api/v1
VITE_WS_URL=/api/v1/ws

# Map tile provider (OpenStreetMap by default - replace with a commercial provider for production)
VITE_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_TILE_ATTRIBUTION=© OpenStreetMap contributors

# Feature flags
VITE_ENABLE_LIVE_MAP=true
VITE_ENABLE_DEMO_MODE=true