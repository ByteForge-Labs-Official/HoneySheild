{
  "title": "Honeynet — Overview",
  "uid": "honeynet-overview",
  "schemaVersion": 39,
  "timezone": "",
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "tags": ["honeynet", "overview"],
  "templating": {
    "list": [
      {
        "type": "query",
        "name": "instance",
        "label": "Host",
        "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
        "query": "label_values(node_cpu_seconds_total, instance)",
        "includeAll": true,
        "multi": true,
        "current": { "selected": true, "text": "All", "value": "$__all" }
      },
      {
        "type": "query",
        "name": "honeypot",
        "label": "Honeypot",
        "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
        "query": "label_values(honeypot_unauth_attempts_total, honeypot)",
        "includeAll": true,
        "multi": true,
        "current": { "selected": true, "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Host CPU utilisation %",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 7 },
      "targets": [
        {
          "expr": "100 - (avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\", instance=~\"$instance\"}[5m])) * 100)",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": 0 }, { "color": "yellow", "value": 70 }, { "color": "red", "value": 85 } ] } } }
    },
    {
      "type": "timeseries",
      "title": "Host memory available %",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 7 },
      "targets": [
        {
          "expr": "(node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes) * 100",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 } }
    },
    {
      "type": "timeseries",
      "title": "Disk usage % per mountpoint",
      "gridPos": { "x": 0, "y": 7, "w": 12, "h": 7 },
      "targets": [
        {
          "expr": "100 - ((node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay\"} / node_filesystem_size_bytes{fstype!~\"tmpfs|overlay\"}) * 100)",
          "legendFormat": "{{instance}}:{{mountpoint}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 } }
    },
    {
      "type": "timeseries",
      "title": "Network throughput",
      "gridPos": { "x": 12, "y": 7, "w": 12, "h": 7 },
      "targets": [
        {
          "expr": "sum by (instance, device) (rate(node_network_receive_bytes_total{instance=~\"$instance\"}[5m]))",
          "legendFormat": "rx {{instance}}:{{device}}"
        },
        {
          "expr": "sum by (instance, device) (rate(node_network_transmit_bytes_total{instance=~\"$instance\"}[5m]))",
          "legendFormat": "tx {{instance}}:{{device}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "Bps" } }
    },
    {
      "type": "stat",
      "title": "Honeypot unauth attempts (last 1h)",
      "gridPos": { "x": 0, "y": 14, "w": 8, "h": 5 },
      "targets": [
        {
          "expr": "sum(increase(honeypot_unauth_attempts_total{honeypot=~\"$honeypot\"}[1h]))"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": 0 }, { "color": "yellow", "value": 1000 }, { "color": "red", "value": 10000 } ] } } }
    },
    {
      "type": "stat",
      "title": "Container OOM events (last 10m)",
      "gridPos": { "x": 8, "y": 14, "w": 8, "h": 5 },
      "targets": [
        {
          "expr": "sum(increase(container_oom_events_total[10m]))"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": 0 }, { "color": "red", "value": 1 } ] } } }
    },
    {
      "type": "stat",
      "title": "Active TCP connections",
      "gridPos": { "x": 16, "y": 14, "w": 8, "h": 5 },
      "targets": [
        {
          "expr": "sum(node_netstat_Tcp_CurrEstab)"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    }
  ]
}
