# ============================================================================
# .env.example — copy to .env and replace every "changeme-…" before boot.
# ----------------------------------------------------------------------------
# Variables prefixed with HONEYPET_, POSTGRES_, REDIS_, GF_, AM_, PROM_,
# RELAY_, CF_ and LETSENCRYPT_ are read by docker-compose; everything else
# is consumed by the in-container services.
# ============================================================================

# --- Honeypot ----------------------------------------------------------------
HONEYPOT_PORT=2222
HONEYPOT_PROFILE=full               # ssh | http | rtsp | full
HONEYPOT_BIND=0.0.0.0
JAVA_OPTS=-Xms64m -Xmx256m -XX:MaxRAMPercentage=75.0 -XX:+ExitOnOutOfMemoryError
TZ=UTC

# --- Database ----------------------------------------------------------------
POSTGRES_USER=honeynet
POSTGRES_PASSWORD=changeme-32-chars-minimum
POSTGRES_DB=honeynet
GF_DB_USER=grafana
GF_DB_PASSWORD=changeme-32-chars-minimum

# --- Redis -------------------------------------------------------------------
REDIS_PASSWORD=changeme-32-chars-minimum

# --- Grafana -----------------------------------------------------------------
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=changeme-32-chars-minimum
GF_SECRET_KEY=changeme-64-bytes-hex

# --- Alertmanager & Prometheus ------------------------------------------------
AM_USER=admin
AM_PASSWORD=changeme-32-chars-minimum
PROM_USER=admin
PROM_PASSWORD=changeme-32-chars-minimum

# --- Caddy / TLS -------------------------------------------------------------
CF_API_TOKEN=changeme-cloudflare-api-token
DASHBOARD_DOMAIN=honeynet.example.com
ALERTMANAGER_DOMAIN=alerts.example.com
PROMETHEUS_DOMAIN=prom.example.com
HONEYPOT_DOMAIN=bait.example.com
LETSENCRYPT_EMAIL=ops@example.com

# --- Relay -------------------------------------------------------------------
RELAY_PG_DSN=postgresql://relay:changeme-relay-password@postgres:5432/honeynet
RELAY_POLL_INTERVAL_S=10

# --- Slack / PagerDuty routing -----------------------------------------------
PD_ROUTING_KEY=changeme-pagerduty-integration-key
SLACK_WEBHOOK_SEC=https://hooks.slack.com/services/changeme/changeme/changeme
SLACK_WEBHOOK_OPS=https://hooks.slack.com/services/changeme/changeme/changeme
SLACK_WEBHOOK_DBA=https://hooks.slack.com/services/changeme/changeme/changeme

# --- Operator-only overrides -------------------------------------------------
COMPOSE_PROJECT_NAME=honeynet
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3