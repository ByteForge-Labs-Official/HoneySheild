# ============================================================================
# Honeynet backend - example environment.
# Copy to .env and override values for your deployment.
# ============================================================================

# --- runtime ---------------------------------------------------------------
APP_ENV=development          # one of: development | staging | production
APP_NAME=honeynet-api
APP_VERSION=1.0.0
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# --- security --------------------------------------------------------------
JWT_SECRET=change-me-to-a-64-byte-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MIN=30
JWT_REFRESH_TTL_DAYS=7
SESSION_SECRET=change-me-too
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
ALLOWED_HOSTS=*

# --- database --------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=honeynet
POSTGRES_USER=honeynet
POSTGRES_PASSWORD=honeynet
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_ECHO=false

# --- redis / celery --------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
FLOWER_USER=flower
FLOWER_PASSWORD=change-me

# --- mqtt / integrations ---------------------------------------------------
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

IDS_SURICATA_EVE_URL=http://suricata:4760/eve.json
IDS_ZEEK_LOG_DIR=/var/log/zeek

# --- ai / nlp --------------------------------------------------------------
OPENAI_API_KEY=
OLLAMA_HOST=http://ollama:11434

# --- geoip -----------------------------------------------------------------
GEOIP_DB_PATH=/data/GeoLite2/GeoLite2-City.mmdb