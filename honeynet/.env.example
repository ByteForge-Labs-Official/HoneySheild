# ============================================================================
# Honeynet Research Platform — root environment template
# ---------------------------------------------------------------------------
# Copy to .env and fill in real values.  All services read from this file
# through docker-compose's variable substitution; nothing committed here may
# contain production credentials.
# ============================================================================

# ---------------------------------------------------------------------------
# 1. Compose / project-wide
# ---------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=honeynet
COMPOSE_FILE=deploy/docker-compose.yml

# ---------------------------------------------------------------------------
# 2. Postgres
# ---------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=honeynet
POSTGRES_USER=honeynet
POSTGRES_PASSWORD=changeme-strong-pg-pass
POSTGRES_ADMIN_PASSWORD=changeme-strong-pg-admin
POSTGRES_DATA=/var/lib/postgresql/data

# ---------------------------------------------------------------------------
# 3. Redis (cache + Celery broker + pub/sub for live attacks)
# ---------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=changeme-strong-redis-pass
REDIS_MAXMEMORY=512mb
REDIS_MAXMEMORY_POLICY=allkeys-lru

# ---------------------------------------------------------------------------
# 4. FastAPI backend
# ---------------------------------------------------------------------------
APP_ENV=development            # development | staging | production
LOG_LEVEL=INFO
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_WORKERS=2
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:80

# JWT — generate via `openssl rand -hex 64` for production
JWT_SECRET=changeme-jwt-signing-secret
JWT_ALG=HS256
JWT_ACCESS_TTL_MIN=60
JWT_REFRESH_TTL_DAYS=7

# AI / ML
AI_PROVIDER=local              # local | openai | ollama
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1:8b

# ---------------------------------------------------------------------------
# 5. React frontend (Vite)
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000

# ---------------------------------------------------------------------------
# 6. MQTT — IoT-bait broker + bridge
# ---------------------------------------------------------------------------
MQTT_HOST=mqtt
MQTT_PORT=1883
MQTT_TLS_PORT=8883
MQTT_ADMIN_USER=honeypot
MQTT_ADMIN_PASSWORD=changeme-strong-mqtt-pass
MQTT_BRIDGE_USER=bridge
MQTT_BRIDGE_PASSWORD=changeme-strong-bridge-pass

# ---------------------------------------------------------------------------
# 7. Suricata / Zeek IDS
# ---------------------------------------------------------------------------
SURICATA_IFACE=eth0
SURICATA_RULES=/etc/suricata/rules
ZEEK_IFACE=eth0
ZEEK_LOG_DIR=/var/log/zeek

# ---------------------------------------------------------------------------
# 8. ELK
# ---------------------------------------------------------------------------
ELASTIC_VERSION=8.13.0
ELASTIC_PASSWORD=changeme-strong-elastic
KIBANA_PASSWORD=changeme-strong-kibana
LOGSTASH_BEATS_PORT=5044

# ---------------------------------------------------------------------------
# 9. Grafana
# ---------------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme-strong-grafana
GRAFANA_ROOT_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# 10. Honeypot bait ports (publicly exposed via gateway)
# ---------------------------------------------------------------------------
HONEYPOT_PUBLIC_SSH_PORT=2222
HONEYPOT_PUBLIC_TELNET_PORT=2223
HONEYPOT_PUBLIC_HTTP_PORT=8080
HONEYPOT_PUBLIC_HTTPS_PORT=8443
HONEYPOT_PUBLIC_RTSP_PORT=8554
HONEYPOT_PUBLIC_MQTT_PORT=1883
HONEYPOT_PUBLIC_MODBUS_PORT=5020

# Mgmt SSH on the host (relocated from 22)
MGMT_SSH_PORT=2200
